//! Domain rules. Failures stop with `http.abort`.

import http
import http.{HttpCode, Response}

pub class UsersService {
  pub var repo: MemoryUsers

  pub fn of(repo: MemoryUsers) -> self {
    self { repo: repo }
  }

  pub fn list(self) -> Response {
    http.ok(toJsonList(self.repo.rows))
  }

  pub fn create(var self, name: String) -> Response {
    if name.isBlank() {
      return http.abort(HttpCode.BadRequest, "name is blank")
    }
    const (next, row) = self.repo.insert(name)
    self.repo = next
    http.created(toJson(row))
  }

  pub fn get(self, id: i32) -> Response {
    const found = self.repo.find(id)
    if found.isNone() {
      return http.abort(HttpCode.NotFound, "not found")
    }
    http.ok(toJson(found ?: UserRow { id: 0, name: "", active: false }))
  }

  pub fn update(var self, id: i32, name: String) -> Response {
    if name.isBlank() {
      return http.abort(HttpCode.BadRequest, "name is blank")
    }
    const found = self.repo.find(id)
    if found.isNone() {
      return http.abort(HttpCode.NotFound, "not found")
    }
    const current = found ?: UserRow { id: 0, name: "", active: false }
    const row = UserRow { id: id, name: name, active: current.active }
    self.repo = self.repo.replace(row)
    http.ok(toJson(row))
  }

  pub fn setActive(var self, id: i32, active: bool) -> Response {
    const found = self.repo.find(id)
    if found.isNone() {
      return http.abort(HttpCode.NotFound, "not found")
    }
    const current = found ?: UserRow { id: 0, name: "", active: false }
    const row = UserRow { id: id, name: current.name, active: active }
    self.repo = self.repo.replace(row)
    http.ok(toJson(row))
  }

  pub fn remove(var self, id: i32) -> Response {
    if self.repo.find(id).isNone() {
      return http.abort(HttpCode.NotFound, "not found")
    }
    self.repo = self.repo.remove(id)
    http.ok("ok")
  }
}
