//! HTTP in. PATCH active/inactive only. Shares the users controller instance.

import http
import http.Response
import users.{PatchActive, UserRow, toJson}

@Controller("/users")
pub class UsersActiveController {
  var users: UsersController

  pub fn of(users: UsersController) -> self {
    self { users: users }
  }

  @Patch("/:id/active")
  pub fn patch(var self, @Param("id") id: i32, @Body body: PatchActive) -> Response {
    const (next, row, err) = self.users.service.setActive(id, body.active)
    self.users.service = next
    failOrOk(row, err)
  }
}

fn failOrOk(row: UserRow, err: Option<Error>) -> Response {
  if err != None {
    const message = (err ?: panic("err")).message()
    if message == "not found" {
      return http.notFound(message)
    }
    return http.badRequest(message)
  }
  http.ok(toJson(row))
}
