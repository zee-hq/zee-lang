//! HTTP in. Maps the request onto the service. `http` reads `@Get` / `@Param` / `@Body`.

import http
import http.Response
import users.{StoreUser, UserRow, UsersService, toJson, toJsonList}

@Controller("/users")
pub class UsersController {
  internal var service: UsersService

  pub fn of(service: UsersService) -> self {
    self { service: service }
  }

  @Get("/")
  pub fn index(self) -> Response {
    http.ok(toJsonList(self.service.list()))
  }

  @Post("/")
  pub fn store(var self, @Body body: StoreUser) -> Response {
    const (next, row, err) = self.service.create(body.name)
    self.service = next
    failOrCreated(row, err)
  }

  @Get("/:id")
  pub fn show(self, @Param("id") id: i32) -> Response {
    const found = self.service.get(id)
    if found.isNone() {
      return http.notFound("not found")
    }
    http.ok(toJson(found ?: UserRow { id: 0, name: "", active: false }))
  }

  @Put("/:id")
  pub fn update(var self, @Param("id") id: i32, @Body body: StoreUser) -> Response {
    const (next, row, err) = self.service.update(id, body.name)
    self.service = next
    failOrOk(row, err)
  }

  @Delete("/:id")
  pub fn destroy(var self, @Param("id") id: i32) -> Response {
    const (next, err) = self.service.remove(id)
    self.service = next
    if err != None {
      return http.notFound((err ?: panic("err")).message())
    }
    http.ok("ok")
  }
}

fn failOrCreated(row: UserRow, err: Option<Error>) -> Response {
  if err != None {
    return http.badRequest((err ?: panic("err")).message())
  }
  http.created(toJson(row))
}

fn failOrOk(row: UserRow, err: Option<Error>) -> Response {
  if err != None {
    const message = (err ?: panic("err")).message()
    if message == "not found" {
      return http.notFound(message)
    }
    return http.badRequest(message)
  }
  http.ok(toJson(row))
}
