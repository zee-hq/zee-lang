import json
import users.UserRow

describe("UsersService") {
  fn testCreatesAda() {
    var service = UsersService.of(MemoryUsers.empty())
    const res = service.create(StoreUser { name: "ada" })
    expect(res.status).toBe(201)
    const (row, err) = json.decode<UserRow>(res.text)
    expect(err.isNone()).toBe(true)
    expect(row.id).toBe(1)
    expect(row.name).toBe("ada")
    expect(row.active).toBe(true)
    expect(service.repo.rows.len).toBe(1usize)
  }

  fn testSetsActive() {
    var service = UsersService.of(MemoryUsers.empty())
    expect(service.create(StoreUser { name: "ada" }).status).toBe(201)
    const res = service.setActive(1, false)
    expect(res.status).toBe(200)
    const (row, err) = json.decode<UserRow>(res.text)
    expect(err.isNone()).toBe(true)
    expect(row.active).toBe(false)
    expect(row.name).toBe("ada")
    const shown = service.get(1)
    expect(shown.status).toBe(200)
    const (shownRow, shownErr) = json.decode<UserRow>(shown.text)
    expect(shownErr.isNone()).toBe(true)
    expect(shownRow).toEqual(UserRow { id: 1, name: "ada", active: false })
  }

  fn testUpdatesAndRemoves() {
    var service = UsersService.of(MemoryUsers.empty())
    expect(service.create(StoreUser { name: "ada" }).status).toBe(201)
    const updated = service.update(1, StoreUser { name: "ana" })
    expect(updated.status).toBe(200)
    const (row, err) = json.decode<UserRow>(updated.text)
    expect(err.isNone()).toBe(true)
    expect(row.name).toBe("ana")
    const gone = service.remove(1)
    expect(gone.status).toBe(200)
    expect(service.list().text).toBe("[]")
  }

  fn testGetMissing() {
    var service = UsersService.of(MemoryUsers.empty())
    const res = service.get(9)
    expect(res.status).toBe(404)
    expect(res.text).toBe("not found")
  }
}
