//! Persistence port. In-memory stand-in — no SQL runtime yet.

pub data struct MemoryOrders {
  pub const rows: List<OrderRow>
  pub const nextId: i32

  pub fn empty() -> self {
    self { rows: [], nextId: 1 }
  }

  pub fn find(self, id: i32) -> Option<OrderRow> {
    self.rows.find { it.id == id }
  }

  pub fn insert(self, userId: i32, title: String) -> (self, OrderRow) {
    const row = OrderRow { id: self.nextId, userId: userId, title: title }
    (MemoryOrders { rows: self.rows + [row], nextId: self.nextId + 1 }, row)
  }

  pub fn replace(self, row: OrderRow) -> self {
    MemoryOrders {
      rows: self.rows.map { item -> if item.id == row.id { row } else { item } },
      nextId: self.nextId
    }
  }

  pub fn remove(self, id: i32) -> self {
    MemoryOrders { rows: self.rows.filter { it.id != id }, nextId: self.nextId }
  }
}
