//! HTTP responses. Named helpers wrap `response(code, text)`.
//! `continue` is a keyword — 100 is `response(HttpCode.Continue, text)`.

pub data struct Response {
  pub const status: i32
  pub const text: String
  pub const headers: Map<String, String>
}

pub fn response(code: HttpCode, text: String) -> Response {
  const headers: Map<String, String> = {}
  Response { status: code.code(), text: text, headers: headers }
}

pub fn switchingProtocols(text: String) -> Response {
  response(HttpCode.SwitchingProtocols, text)
}

pub fn processing(text: String) -> Response {
  response(HttpCode.Processing, text)
}

pub fn earlyHints(text: String) -> Response {
  response(HttpCode.EarlyHints, text)
}

