//! Official http package: listen, dispatch, and `@Get` / `@Post` on controllers.
//! The language stores `@Name`. This package decides what Get/Post/Controller/Param/Query/Body do.
//! `http.app()` indexes loaded `@Controller` types (Quarkus/Jandex-shaped) and builds them via `of` / `empty`.
//! `@PathPrefix("/api")` prepends `/api` to `@Controller` under `src/modules/` (Spring addPathPrefix).
//! `@Cors` reads associated `properties() -> CorsProperties` (`allowedOrigins` / `allowedOriginPatterns`).
//! Localhost is always allowed (host overlay). Not a `ContainerResponseFilter`. Not `@Inject`.
//! Not a macro. Not a `src/` walk. Not `@Inject`.
//! Host overlay: `httpDispatch` / `httpListen` / `httpI32Param` / `httpRouterController` / `httpApp`.

pub data struct Request {
  pub const method: String
  pub const path: String
  pub const text: String
  pub const params: Map<String, String>
  pub const query: Map<String, String>
  pub const headers: Map<String, String>
}

pub data struct Response {
  pub const status: i32
  pub const text: String
  pub const headers: Map<String, String>
}

pub data struct CorsProperties {
  pub const allowedOrigins: List<String>
  pub const allowedOriginPatterns: List<String>
}

pub data struct StaticGet {
  pub const path: String
  pub const body: String
}

pub data struct Mount {
  pub const prefix: String
  pub const resource: Resource
}

pub data struct Router {
  pub const staticGets: List<StaticGet>
  pub const mounts: List<Mount>
  pub const controllers: List<String>

  pub fn get(self, path: String, body: String) -> Router {
    Router { staticGets: self.staticGets + [StaticGet { path: path, body: body }], mounts: self.mounts, controllers: self.controllers }
  }

  pub fn resource(self, prefix: String, resource: Resource) -> Router {
    Router { staticGets: self.staticGets, mounts: self.mounts + [Mount { prefix: prefix, resource: resource }], controllers: self.controllers }
  }

  pub fn controller<T>(self, instance: T) -> Router {
    httpRouterController(self, instance)
  }
}

pub interface Resource {
  fn index(self, req: Request) -> Response
  fn store(var self, req: Request) -> Response
  fn show(self, req: Request) -> Response
  fn update(var self, req: Request) -> Response
  fn destroy(var self, req: Request) -> Response
}

pub fn router() -> Router {
  const controllers: List<String> = []
  Router { staticGets: [], mounts: [], controllers: controllers }
}

pub fn app() -> Router {
  httpApp()
}

pub fn request(method: String, path: String, text: String) -> Request {
  const params: Map<String, String> = {}
  const query: Map<String, String> = {}
  const headers: Map<String, String> = {}
  Request { method: method, path: path, text: text, params: params, query: query, headers: headers }
}

pub fn ok(text: String) -> Response {
  const headers: Map<String, String> = {}
  Response { status: 200, text: text, headers: headers }
}

pub fn created(text: String) -> Response {
  const headers: Map<String, String> = {}
  Response { status: 201, text: text, headers: headers }
}

pub fn badRequest(text: String) -> Response {
  const headers: Map<String, String> = {}
  Response { status: 400, text: text, headers: headers }
}

pub fn notFound(text: String) -> Response {
  const headers: Map<String, String> = {}
  Response { status: 404, text: text, headers: headers }
}

pub fn i32Param(req: Request, name: String) -> (i32, Option<Error>) {
  httpI32Param(req, name)
}

pub fn dispatch(router: Router, req: Request) -> Response {
  httpDispatch(router, req)
}

pub fn listen(addr: String, router: Router) {
  httpListen(addr, router)
}
